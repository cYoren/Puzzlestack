# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Store screenshots.
# The composed final sets ARE tracked — they are the images that ship to the App Store and
# Google Play, and a future agent must be able to find them without re-running a capture.
# Raw captures and the framed intermediates are regenerable build artifacts and stay ignored.
# See screenshots/README.md for which paths are canonical.
/screenshots/*
!/screenshots/README.md
!/screenshots/aso-refresh/
/screenshots/aso-refresh/*
!/screenshots/aso-refresh/final/
/_frame_preview.png



